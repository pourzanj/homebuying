# Environment variables for daily_fit.R
# Copy this file to .env and fill in your actual values

# Optional: Tiingo API token for stock data
# Only needed if you uncomment get="tiingo" in daily_fit.R
# Default uses Yahoo Finance (get="stock.prices") which doesn't require a token
# RIINGO_TOKEN=your_tiingo_token_here

# Compute source identifier (local, github, docker-local)
# This will appear in Discord messages to show where the job ran
COMPUTE_SOURCE=local

# Optional: Discord webhook URL (if different from hardcoded one)
# DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# Optional: Phone numbers for SMS notifications (Twilio)
# A_PN=+1234567890
# J_PN=+1234567890
# C_PN=+1234567890
# T_PN=+1234567890

# Optional: Email addresses for notifications
# A_E=email1@example.com
# J_E=email2@example.com
# N_E=email3@example.com
# C_E=email4@example.com
# T_E=email5@example.com

# Optional: Gmail API credentials
# GMAILR_APP=path/to/gmailr_app.json
# GMAILR_CACHE=path/to/gmailr_cache
